<?xml version="1.0" encoding="utf-8"?>
<!-- Richard | Part 3: site settings -->
<configuration>
  <connectionStrings>
    <!-- ProjectDB: set YOUR_SERVER_NAME and YOUR_DATABASE_NAME -->
    <add name="ProjectDB" connectionString="Data Source=YOUR_SERVER_NAME;Initial Catalog=YOUR_DATABASE_NAME;Integrated Security=True;Encrypt=False" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <!-- Framework version -->
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
