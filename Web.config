<!-- Richard | Part 3: site settings -->
<configuration>
	<connectionStrings>
		<add name="ProjectDB"
			 connectionString="Data Source=RICHSHP\SQLEXPRESS;Initial Catalog=Project;Integrated Security=True;Encrypt=False"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
	</system.web>
</configuration>
